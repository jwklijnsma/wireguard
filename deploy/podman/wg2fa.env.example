# Copied to /etc/wg2fa/wg2fa.env by install.sh (mode 600). It may hold the admin password.
# Plain KEY=value lines only: no quotes, no comments after a value.
# All variables: https://jwklijnsma.github.io/wireguard/install/configuration/

# Public host[:port] clients connect to (required)
WG2FA_ENDPOINT=vpn.example.nl
WG2FA_SUBNET=10.8.0.0/24
# Name shown in authenticator apps
WG2FA_ISSUER=My VPN

# Otherwise a random password is printed in the journal on first start
#WG2FA_ADMIN_PASSWORD=change-me-now

# Behind Caddy/nginx/Traefik on this host
#WG2FA_TRUST_PROXY=true
#WG2FA_HSTS=true

# Admin pages only from VPN/office
#WG2FA_ADMIN_NETS=10.8.0.0/24,192.168.10.0/24
# Management networks no peer may reach
#WG2FA_BLOCK_NETS=192.168.1.0/24

# Serve HTTPS directly (put the files in the wg2fa-data volume)
#WG2FA_TLS_CERT=/data/tls/fullchain.pem
#WG2FA_TLS_KEY=/data/tls/privkey.pem
