{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Keep digest-only refreshes of base images together",
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "groupName": "digest pins"
    },
    {
      "description": "wireguard-go follows release tags via .github/workflows/wireguard-go-update.yml",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.zx2c4.com/wireguard"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": { "enabled": true }
}
