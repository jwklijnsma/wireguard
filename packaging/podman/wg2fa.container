# WG2FA server as a systemd service via Podman Quadlet (Podman >= 4.6).
#
# Install (rootful, needed for WireGuard + iptables NAT):
#   install -m 644 wg2fa.container /etc/containers/systemd/wg2fa.container
#   install -d -m 700 /etc/wg2fa /var/lib/wg2fa
#   install -m 600 wg2fa.env /etc/wg2fa/wg2fa.env        # then edit it
#   openssl rand -base64 32 | podman secret create wg2fa_state_key -
#   systemctl daemon-reload
#   systemctl start wg2fa.service
#
# See packaging/podman/README.md for details.

[Unit]
Description=WG2FA - WireGuard VPN with 2FA and web GUI
Documentation=https://github.com/jwklijnsma/wireguard
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=wg2fa
Image=ghcr.io/jwklijnsma/wireguard:latest
# Let `podman auto-update` (podman-auto-update.timer) pull new images and restart
AutoUpdate=registry

# WireGuard interface + iptables inside the container's network namespace
AddCapability=NET_ADMIN
# Only needed for the userspace wireguard-go fallback (no kernel module)
AddDevice=/dev/net/tun
Sysctl=net.ipv4.ip_forward=1
Sysctl=net.ipv4.conf.all.src_valid_mark=1

PublishPort=51820:51820/udp
# Web GUI on localhost only: put a TLS reverse proxy in front,
# or set WG2FA_TLS_CERT/KEY and publish 8080 on all interfaces.
PublishPort=127.0.0.1:8080:8080

EnvironmentFile=/etc/wg2fa/wg2fa.env
# State encryption key from `podman secret create wg2fa_state_key -`
Secret=wg2fa_state_key,type=mount,mode=0400,target=/run/secrets/wg2fa_state_key
Environment=WG2FA_STATE_KEY_FILE=/run/secrets/wg2fa_state_key

# Persistent state (state.json, keys). :Z relabels for SELinux.
Volume=/var/lib/wg2fa:/data:Z

HealthCmd=wget -qO- http://127.0.0.1:8080/healthz
HealthInterval=30s
HealthTimeout=3s
HealthRetries=3
# Restart the container when the health check keeps failing
HealthOnFailure=kill
# Podman >= 5.0: report "started" to systemd only once healthy
#Notify=healthy

[Service]
Restart=always
RestartSec=5
# First start pulls the image
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
